</fieldset>

<fieldset>
<legend>REST API for batch annotation</legend>

<table>
<tr>
<td><span class='http_method'>POST</span></td>
<td><div id="batch_rest_url"></div></td>
<td>
<button class="btn" id="clip-btn-url" data-clipboard-action="copy" data-clipboard-target="#batch_rest_url">
	<%= image_tag 'clippy.svg', class: 'clippy', width: 13, alt: 'Copy to clipboard', title: 'Copy to clipboard' %>
</button>
</td>
</tr>
</table>

<h2>Example cURL command</h2>
<table>
<tr>
<th>1</th>
<td><span class='http_method'>POST</span></td>
<td><div id="batch_curl_command"></div></td>
<td>
	<button class="btn" id="clip-btn-get" data-clipboard-action="copy" data-clipboard-target="#batch_curl_command">
		<%= image_tag 'clippy.svg', class: 'clippy', width: 13, alt: 'Copy to clipboard' %>
	</button>
</td>
</tr>

</table>
</fieldset>

<script type="text/javascript">
	$(function() {
		dictionarySelectionInit();

		var clipboard_url   = new Clipboard('#clip-btn-url');
		var clipboard_get   = new Clipboard('#clip-btn-get');
		var clipboard_post1 = new Clipboard('#clip-btn-post1');
		var clipboard_post2 = new Clipboard('#clip-btn-post2');
		var clipboard_post3 = new Clipboard('#clip-btn-post3');
	});

	$('#dictionaries').change(function() {
		set_url();
	});

	$('#tokens_len_min').change(function() {
		set_url();
	});

	$('#tokens_len_max').change(function() {
		set_url();
	});

	$('#threshold').change(function() {
		set_url();
	});

	$("#use_semantic_similarity").change(function() {
		set_url();
	});

	$('#semantic_threshold').change(function() {
		set_url();
	});

	$("#abbreviation").change(function() {
		set_url();
	});

	$("#longest").change(function() {
		set_url();
	});

	$("#superfluous").change(function() {
		set_url();
	});

	$("#verbose").change(function() {
		set_url();
	});

	$("#ngram").change(function() {
		set_url();
	});

	$('#text_annotation').on('reset', function(e) {
		setTimeout(function() {
			dictionarySelectionReset();
			set_url();
		}, 0);
	});

	function set_url() {
		var params = [];

		if ($('#dictionaries').text()) {
			var param_dics = 'dictionary=' + $('#dictionaries').text();
			params.push(param_dics);
		}

		var tokens_len_min = $('#tokens_len_min').val();
		if (tokens_len_min != '') {
			var param = 'tokens_len_min=' + tokens_len_min;
			params.push(param);
		}

		var tokens_len_max = $('#tokens_len_max').val();
		if (tokens_len_max != '') {
			var param = 'tokens_len_max=' + tokens_len_max;
			params.push(param);
		}

		var threshold = $('#threshold').val();
		if (threshold != '') {
			var param = 'threshold=' + threshold;
			params.push(param);
		}

		var use_semantic_similarity = $('#use_semantic_similarity').is(':checked');
		var semantic_threshold = $('#semantic_threshold').val();
		if (use_semantic_similarity && semantic_threshold) {
			var param = 'semantic_threshold=' + semantic_threshold;
			params.push(param);
		}

		var abbreviation = $('#abbreviation').is(':checked');
		if (abbreviation != <%= options_default[:abbreviation] %>) {
			var param = 'abbreviation=' + abbreviation;
			params.push(param);
		}

		var longest = $('#longest').is(':checked');
		if (longest != <%= options_default[:longest] %>) {
			var param = 'longest=' + longest;
			params.push(param);
		}

		var superfluous = $('#superfluous').is(':checked');
		if (superfluous != <%= options_default[:superfluous] %>) {
			var param = 'superfluous=' + superfluous;
			params.push(param);
		}

		var verbose = $('#verbose').is(':checked');
		if (verbose != <%= options_default[:verbose] %>) {
			var param = 'verbose=' + verbose;
			params.push(param);
		}

		var ngram = $('#ngram').is(':checked');
		if (ngram != <%= options_default[:use_ngram_similarity] %>) {
			var param = 'ngram=' + ngram;
			params.push(param);
		}

		var url = '<%= root_url %>text_annotation.json'
		if (params.length > 0) {url += '?' + params.join('&')}
		$('#rest_url').text(url);

		var command_get   = 'curl -G --data-urlencode text="example text" "' + url + '"';
		var command_post1 = 'curl -d text="example text" "' + url + '"';
		var command_post2 = 'curl -H "content-type:application/json" -d \'{"text":"example text"}\' "' + url + '"';
		var command_post3 = 'curl -H "content-type:text/plain" -d "example text" "' + url + '"';

		$('#curl_command_get').text(command_get);
		$('#curl_command_post1').text(command_post1);
		$('#curl_command_post2').text(command_post2);
		$('#curl_command_post3').text(command_post3);

		var batch_url = '<%= root_url %>annotation_tasks'
		if (params.length > 0) {batch_url += '?' + params.join('&')}
		$('#batch_rest_url').text(batch_url);

		var batch_command = 'curl -H "content-type:application/json" -d \'[{"text":"example text 1"},{"text":"example text 2"}]\' "' + batch_url + '"';
		$('#batch_curl_command').text(batch_command);
	}
</script>

<%# =========================================================================
     AI chat (Tier-1 pilot, dev-only). See project_page_embedded_actions memo.
     Widget markup + CSS + orchestrator wiring come from the
     llm_meta_widget gem (the `llm_meta_widget` helper below). Everything
     host-specific stays here: (1) the page card declaring this page's tools and
     resources, (2) the
     window.aiResources readers, (3) the window.aiActions implementations.
   ========================================================================= %>

<% if Rails.configuration.x.llm_hub_url.present? %>
  <% hub = Rails.configuration.x.llm_hub_url %>
  <%# The hub answers the chat AND registers the MCP tools on offer; those are
      separate settings in the widget, so name it for both. %>
  <%= llm_meta_widget(llm_url:      hub,
                      tool_hub_url: hub,
                      # The widget defaults to "ollama-local", which only
                      # resolves local models: the hub looks a meta_id up
                      # WITHIN the key's family, so a hosted model under that
                      # key is simply not found and the turn fails inside the
                      # stream. "free-models" is the hub's pseudo-key for
                      # everything flagged free — local or hosted — paid for
                      # by the server's own credential.
                      api_key_uuid: "free-models",
                      # Hosted since 2026-10-10. The local qwen it replaced
                      # serves one request at a time, so a demo audience queued
                      # behind each other. Tool calling was verified on this
                      # path before the switch — this page depends on it.
                      model:        "gpt-oss-120b",
                      # Page actions round-trip now, so each write costs a
                      # round of its own: read the catalog, fill the form,
                      # annotate, answer — with slack for a model that spends
                      # a couple of rounds looking around first.
                      max_rounds: 12,
                      greeting: "Hi — I can annotate text against PubDictionaries for you. " \
                                "Paste or describe what you want annotated and I'll pick suitable " \
                                "dictionaries, fill in the form on this page, and run it. " \
                                "You can also just ask me things like \"which dictionaries cover " \
                                "anatomy?\" Or start here:") %>
<% end %>

<%# (1) The page card — the same `io.modelcontextprotocol/static-primitives`
     envelope a server puts in its Server Card, delivered in this document.
     It declares what this page offers; the handlers below implement it,
     each keyed by the identifier its own protocol operation takes:
     tools by name (tools/call), resources by uri (resources/read).
     It replaces the older #ai-actions schema tag outright. %>
<%# The id is redundant for a widget of 0.10.0 or newer, which finds this block
     by its media type, and is kept because a visitor's browser may still be
     served an older one: 0.9.x looks the card up by id alone, and dropping the
     id made the card invisible to it — every tool, prompt and resource on this
     page silently disappeared. Remove the id once no deployment serves a
     widget older than 0.10.0. A widget that understands the type reads this
     block once, not twice. %>
<script type="application/mcp-static-primitives+json" id="ai-page">
{
  "name": "org.pubdictionaries/text-annotation",
  "_meta": {
    "io.modelcontextprotocol/static-primitives": {
      "transports": [
        {
          "type": "page-global",
          "global": "mcp"
        }
      ],
      "tools": [
        {
          "name": "add_dictionaries",
          "description": "Add one or more dictionaries to the current selection.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Dictionary names to add."
              }
            },
            "required": [
              "names"
            ]
          }
        },
        {
          "name": "remove_dictionaries",
          "description": "Remove one or more dictionaries from the current selection.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "names"
            ]
          }
        },
        {
          "name": "set_dictionaries",
          "description": "Replace the current dictionary selection with the given list (clears then adds).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "names"
            ]
          }
        },
        {
          "name": "set_semantic_threshold",
          "description": "Set the semantic similarity threshold (0.0-1.0). Enables semantic similarity if not already on.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "name": "set_surface_threshold",
          "description": "Set the surface similarity threshold (0.0-1.0).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "name": "set_option",
          "description": "Toggle a boolean annotation option. Valid names: longest, superfluous, verbose, abbreviation, use_ngram_similarity, use_semantic_similarity.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        },
        {
          "name": "set_text",
          "description": "Replace the text-to-annotate with the given string.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      ],
      "prompts": [
        {
          "name": "annotate",
          "title": "Annotate text",
          "description": "Annotate a passage of text. Finds suitable dictionaries for you if none are selected.",
          "arguments": [
            {
              "name": "text",
              "description": "The text to annotate, if the page already has some.",
              "required": false
            },
            {
              "name": "dictionaries",
              "description": "Comma-separated dictionary names already selected on the page, if any.",
              "required": false
            }
          ]
        }
      ],
      "resources": [
        {
          "uri": "page:text",
          "name": "Text to annotate",
          "description": "the text the user wants to annotate",
          "mimeType": "application/json",
          "volatility": "volatile"
        },
        {
          "uri": "page:selected_dictionaries",
          "name": "Selected dictionaries",
          "description": "the dictionaries currently chosen for annotation",
          "mimeType": "application/json",
          "volatility": "volatile"
        },
        {
          "uri": "page:available_dictionaries",
          "name": "Available dictionaries",
          "description": "every dictionary that can be chosen — only names from this list exist, do not invent others",
          "mimeType": "application/json",
          "volatility": "stable"
        },
        {
          "uri": "page:semantic_threshold",
          "name": "Semantic threshold",
          "description": "the semantic-similarity cut-off, or null when unset",
          "mimeType": "application/json",
          "volatility": "volatile"
        },
        {
          "uri": "page:surface_threshold",
          "name": "Surface threshold",
          "description": "the surface-string-similarity cut-off, or null when unset",
          "mimeType": "application/json",
          "volatility": "volatile"
        },
        {
          "uri": "page:options",
          "name": "Annotation options",
          "description": "the annotation option toggles, each true when the user has enabled it",
          "mimeType": "application/json",
          "volatility": "volatile"
        }
      ]
    }
  }
}
</script>

<%# (2) aiState readers — called locally each turn to feed the LLM current page state. %>
<%# (3) aiActions — invoked by the widget AFTER the LLM emits a tool_call (fire-and-forget). %>
<script type="text/javascript">
	(function() {
		var OPTION_ID_BY_NAME = {
			longest:                 "longest",
			superfluous:             "superfluous",
			verbose:                 "verbose",
			abbreviation:            "abbreviation",
			use_ngram_similarity:    "ngram",
			use_semantic_similarity: "use_semantic_similarity"
		};

		function readSelectedDictionaries() {
			var raw = ($("#dictionaries").val() || $("#dictionaries").text() || "").trim();
			if (!raw) return [];
			return raw.split(",").map(function(s) { return s.trim(); }).filter(Boolean);
		}

		function readAvailableDictionaries() {
			// Every .dictionary tile carries the true name in its `name` attribute
			// (see _selected_dictionary / _unselected_dictionary partials). Union
			// across both panes; dedupe because the same name is rendered on each
			// side and visibility just toggles.
			var names = [];
			var seen = {};
			$("#selected_dictionaries > .dictionary, #unselected_dictionaries > .dictionary").each(function() {
				var n = $(this).attr("name");
				if (n && !seen[n]) { seen[n] = true; names.push(n); }
			});
			return names;
		}

		// The page card declares this prompt; this is its handler. It was served by
		// this app's MCP server until 2026-10-14. It belongs here because every step
		// it describes is a call against THIS page, and because a page handler can
		// read the live form rather than work from whatever arguments a caller
		// happened to pass. It stays a prompt primitive, user-selected: the widget
		// puts the text in the box and the visitor sends it.
		var SELECT_DICTIONARIES = [
			"No dictionaries are selected yet, and annotation needs at least one.",
			"The dictionary list is probably already in your context, under",
			"\"Reference data — PubDictionaries catalog\": if it is there, read it and",
			"do NOT call list_dictionaries at all. Only if it is absent, make ONE",
			"list_dictionaries call — one, not several — passing a keyword from the",
			"text as the query when that narrows it usefully.",
			"Pick the two or three whose name and description best match what the",
			"text is about, and say in one line why. Do not look terms up to decide",
			"this; the names and descriptions are what you are choosing on.",
			""
		].join("\n");

		// Annotates through the text_annotation TOOL and reports the matches in the
		// chat. Driving the page's own result view instead was tried on 2026-10-15
		// and withdrawn: it needs a tool that navigates, and nothing the model can
		// be told makes it answer before a navigation it performs itself.
		var ANNOTATE_STEPS = [
			"Then, using as few steps as you can:",
			"1. Call set_dictionaries with the dictionaries you chose. When it comes",
			"   back, call set_text with the text. These are two separate calls, so",
			"   the form on the page ends up showing both.",
			"2. Call text_annotation with that same text and those dictionaries.",
			"3. Tell me what it found — the matched terms with their identifiers —",
			"   or say plainly that nothing matched. Mention that the form is now",
			"   filled in, so I can press Submit to see it on the page myself.",
			"You have already run the annotation yourself in step 2, so do not submit",
			"the form as well — it would only repeat what you have done. Pressing",
			"Submit is mine to do when I want the page's own view.",
			"Do not repeat a call you have already made.",
			""
		].join("\n");

		// One namespace for everything this page implements, named in the card above
		// so a consumer that has never heard of this widget can still find it. The
		// sub-keys are the protocol's, not ours: tools, prompts, resources.
		window.mcp = { tools: {}, prompts: {}, resources: {} };

		window.mcp.prompts = {
			annotate: function(args) {
				var text = (args && args.text ? String(args.text) : "").trim();
				var dicts = (args && args.dictionaries ? String(args.dictionaries) : "").trim();
				var steps = [];
			
				if (!text) {
					steps.push("Ask me for the text I want to annotate. Once I give it:");
					if (!dicts) steps.push(SELECT_DICTIONARIES);
					else steps.push("Dictionaries already selected on the page: " + dicts + ".");
					steps.push(ANNOTATE_STEPS);
					return steps.join("\n");
				}
			
				if (!dicts) steps.push(SELECT_DICTIONARIES);
				else steps.push("Annotate the text below against the " + dicts + " dictionary/dictionaries.");
				steps.push(ANNOTATE_STEPS);
				steps.push("\nText to annotate:\n" + text);
				return steps.join("\n");
			}
		};

		// Each reader declares what it returns (llm_meta_widget 0.8.0+; the bare
		// function form it replaces is no longer accepted). The descriptions are
		// read by the model every turn, so they are the place to put what it must
		// know about a value — not just what the value is.
		// The page card above declares these; this map implements them, keyed by
		// URI because that is what resources/read takes. The descriptions live in
		// the card now — they are read by the model every turn, so that is where
		// what it must know about a value belongs.
		window.mcp.resources = {
			"page:text": function() { return $("#text").val() || ""; },
			"page:selected_dictionaries": readSelectedDictionaries,
			"page:available_dictionaries": readAvailableDictionaries,
			"page:semantic_threshold": function() { return parseFloat($("#semantic_threshold").val()) || null; },
			"page:surface_threshold": function() { return parseFloat($("#threshold").val()) || null; },
			"page:options": function() {
				var out = {};
				Object.keys(OPTION_ID_BY_NAME).forEach(function(name) {
					var el = document.getElementById(OPTION_ID_BY_NAME[name]);
					if (el && el.type === "checkbox") out[name] = el.checked;
				});
				return out;
			}
		};

		// Throw if the requested dictionary name has no matching tile in the
		// DOM. Silent no-ops would leave the widget UI showing "✔" while the
		// page state didn't actually change — misleading. Loud errors surface
		// as "❌ add_dictionaries: unknown dictionary: foo" in the chat panel.
		function requireDictionaryExists(n) {
			if ($("#unselected_dictionaries > .dictionary[name='" + n + "'], #selected_dictionaries > .dictionary[name='" + n + "']").length === 0) {
				throw new Error("unknown dictionary: " + n);
			}
		}

		window.mcp.tools = {
			add_dictionaries: function(args) {
				(args.names || []).forEach(function(n) {
					requireDictionaryExists(n);
					if (typeof selectDictionary === "function") selectDictionary(n);
				});
				if (typeof setParamDics === "function") setParamDics();
			},
			remove_dictionaries: function(args) {
				(args.names || []).forEach(function(n) {
					requireDictionaryExists(n);
					if (typeof unselectDictionary === "function") unselectDictionary(n);
				});
				if (typeof setParamDics === "function") setParamDics();
			},
			set_dictionaries: function(args) {
				(args.names || []).forEach(requireDictionaryExists);
				// Unselect ALL currently visible in #selected_dictionaries, then add the new set.
				$("#selected_dictionaries > .dictionary:visible").each(function() {
					var name = $(this).find(".name").text().trim();
					if (name && typeof unselectDictionary === "function") unselectDictionary(name);
				});
				(args.names || []).forEach(function(n) {
					if (typeof selectDictionary === "function") selectDictionary(n);
				});
				if (typeof setParamDics === "function") setParamDics();
			},
			set_semantic_threshold: function(args) {
				var v = parseFloat(args.value);
				if (isNaN(v)) return;
				// Auto-enable the semantic similarity checkbox so the value actually applies.
				var checkbox = document.getElementById("use_semantic_similarity");
				if (checkbox && !checkbox.checked) { checkbox.checked = true; $(checkbox).trigger("change"); }
				$("#semantic_threshold").val(v).trigger("change");
			},
			set_surface_threshold: function(args) {
				var v = parseFloat(args.value);
				if (isNaN(v)) return;
				$("#threshold").val(v).trigger("change");
			},
			set_option: function(args) {
				var elId = OPTION_ID_BY_NAME[args.name];
				if (!elId) throw new Error("unknown option: " + args.name);
				var el = document.getElementById(elId);
				if (!el || el.type !== "checkbox") throw new Error("no checkbox for option: " + args.name);
				el.checked = !!args.value;
				$(el).trigger("change");
			},
			set_text: function(args) {
				$("#text").val(String(args.text || ""));
			},
			// Implemented for the page's own use, and deliberately NOT declared to the
			// assistant. Submitting navigates, which ends the document the widget lives
			// in, and the model's answer is written AFTER a tool result — so a declared
			// submit_annotation cut the turn off before the answer existed.
			//
			// Tried on 2026-10-15 and withdrawn: asking for the answer before the call
			// ended the turn early; asking for it in the same message produced one thin
			// line, then nothing. Deferring the submit to a turn-end event did work,
			// but it needs a widget feature and a page-side flag for something no card
			// can declare, so it waits for a better answer. Pressing Submit stays the
			// visitor's to do.
			submit_annotation: function() {
				$("#text_annotation").submit();
			}
		};

		// NO aliases for window.aiActions / aiPrompts / aiResources, deliberately.
		// The widget still reads those names when a card declares no transport, so
		// other adopters are unaffected — but this page is the reference
		// implementation, and it runs the declared path only.
		//
		// The reason is that an alias here would let a stale deployment keep working:
		// a checkout that pulled this view without running `bundle install` would
		// serve an older widget, find the legacy names, and behave correctly, so
		// nobody would notice the deployment was stale. Both failures this page has
		// had were of exactly that shape, found by a person rather than by anything
		// failing. Without the aliases an old widget finds no handlers and says so.
	})();
</script>

