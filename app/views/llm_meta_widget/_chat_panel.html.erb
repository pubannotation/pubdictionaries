<%# Chat-panel widget for the client-orchestrated flow. Render via the %>
<%# llm_meta_widget helper — see llm_meta_widget_helper.rb for options. %>
<%# %>
<%# Required locals: base_url, model. %>
<%# Optional locals (defaults in the helper's DEFAULTS constant): %>
<%#   api_key_uuid, orchestrator_path, actions_schema_id, state_global, %>
<%#   actions_global, remote_tools_schema_id, well_known_urls, max_rounds. %>
<%# %>
<%# The host page must ALSO provide, on the same page: %>
<%#   (a) a JSON schema block with id = actions_schema_id, listing the %>
<%#       local action set (name/description/input_schema each). %>
<%#   (b) window.aiState — reader functions called each turn. %>
<%#   (c) window.aiActions — action implementations invoked after the LLM %>
<%#       turn completes. %>
<%# %>
<%# NOTE on ERB comments: DO NOT try to consolidate these lines into one %>
<%# <%_# ... %_> block. Rails-ERB comment blocks terminate at the FIRST %>
<%# closing `%_>`, so any nested <%_= ... %_> inside cuts them short and %>
<%# the trailing lines leak into rendered HTML — including any literal %>
<%# `<script>` text, which then swallows the widget div. One line per %>
<%# comment keeps them self-terminating. %>

<style>
	#ai-chat { position: fixed; bottom: 1em; right: 1em; width: 26em; max-height: 60vh;
	           background: #fff; border: 1px solid #999; border-radius: 6px;
	           box-shadow: 0 2px 8px rgba(0,0,0,.15); padding: 8px; z-index: 9999;
	           font: 12px/1.35 -apple-system,BlinkMacSystemFont,sans-serif;
	           display: flex; flex-direction: column; }
	#ai-chat header { display: flex; justify-content: space-between; align-items: center;
	                  border-bottom: 1px solid #eee; padding-bottom: 4px; margin-bottom: 4px; }
	#ai-chat header strong { color: #444; }
	#ai-chat-history { flex: 1; overflow-y: auto; padding-right: 4px; max-height: 40vh;
	                   min-height: 4em; margin-bottom: 6px; }
	.ai-chat-turn { margin-bottom: 6px; padding: 4px 6px; border-radius: 4px; }
	.ai-chat-turn.user      { background: #eaf3ff; }
	.ai-chat-turn.assistant { background: #f5f5f5; }
	.ai-chat-turn.system    { background: #fff8dc; font-style: italic; }
	.ai-chat-turn.error     { background: #ffd6d6; color: #900; }
	.ai-chat-turn strong { color: #555; margin-right: 4px; }
	#ai-chat-form { display: flex; gap: 4px; }
	#ai-chat-input { flex: 1; font: inherit; padding: 4px 6px;
	                 border: 1px solid #ccc; border-radius: 3px; }
	#ai-chat-form button { font: inherit; padding: 4px 10px; cursor: pointer; }
</style>

<div id="ai-chat">
	<header>
		<strong>AI assistant</strong>
		<button type="button" id="ai-chat-clear" style="font: inherit; border: none; background: transparent; color: #666; cursor: pointer" title="Clear conversation">clear</button>
	</header>
	<div id="ai-chat-history"></div>
	<form id="ai-chat-form">
		<input id="ai-chat-input" placeholder="e.g. add uberon" autocomplete="off" />
		<button type="submit">Send</button>
	</form>
</div>

<script type="module">
	import { runChatLoop, fetchMcpManifest } from "<%= orchestrator_path %>";

	var META_BASE              = <%= base_url.to_json.html_safe %>;
	var API_KEY_UUID           = <%= api_key_uuid.to_json.html_safe %>;
	var MODEL                  = <%= model.to_json.html_safe %>;
	var ACTIONS_SCHEMA_ID      = <%= actions_schema_id.to_json.html_safe %>;
	var STATE_GLOBAL           = <%= state_global.to_json.html_safe %>;
	var ACTIONS_GLOBAL         = <%= actions_global.to_json.html_safe %>;
	var REMOTE_TOOLS_SCHEMA_ID = <%= remote_tools_schema_id.to_json.html_safe %>;
	var MAX_ROUNDS             = <%= max_rounds.to_json.html_safe %>;
	// nil → auto-discover same-origin /.well-known/mcp.json; explicit array → use those.
	var WELL_KNOWN_URLS        = <%= raw(well_known_urls.nil? ? "null" : well_known_urls.to_json) %>;

	var conversation = [];  // [{role, content}, ...] — grows across turns
	var actionsSchemaEl = document.getElementById(ACTIONS_SCHEMA_ID);
	var localTools = actionsSchemaEl ? JSON.parse(actionsSchemaEl.textContent) : [];
	var remoteToolsEl = document.getElementById(REMOTE_TOOLS_SCHEMA_ID);
	var remoteTools = remoteToolsEl ? JSON.parse(remoteToolsEl.textContent) : [];

	// Class 2: fetch well-known MCP manifests at boot. Auto-discovers same
	// origin if WELL_KNOWN_URLS is null; empty array disables entirely.
	var hostWideTools = [];
	var wellKnownReady = (async function() {
		var urls = WELL_KNOWN_URLS === null
			? [ window.location.origin + "/.well-known/mcp.json" ]
			: WELL_KNOWN_URLS;
		for (var i = 0; i < urls.length; i++) {
			var tools = await fetchMcpManifest(urls[i]);
			hostWideTools = hostWideTools.concat(tools);
		}
	})();

	var historyEl = document.getElementById("ai-chat-history");
	var formEl    = document.getElementById("ai-chat-form");
	var inputEl   = document.getElementById("ai-chat-input");
	var clearBtn  = document.getElementById("ai-chat-clear");

	function appendTurn(role, text) {
		var div = document.createElement("div");
		div.className = "ai-chat-turn " + role;
		var label = document.createElement("strong");
		label.textContent = role + ":";
		var body = document.createElement("span");
		body.textContent = text;
		div.appendChild(label);
		div.appendChild(document.createTextNode(" "));
		div.appendChild(body);
		historyEl.appendChild(div);
		historyEl.scrollTop = historyEl.scrollHeight;
		return body;
	}

	// Thinking-token accumulator: for models like qwen3-6-35b that emit lots
	// of thinking_delta events before any text_delta, we render a collapsible
	// "🤔 thinking" block above the assistant bubble so the user sees progress
	// rather than an empty bubble. Cleared/hidden once text_delta starts.
	function ensureThinkingBlock() {
		if (currentThinkingBody) return currentThinkingBody;
		var details = document.createElement("details");
		details.className = "ai-chat-thinking";
		details.open = true;
		var summary = document.createElement("summary");
		summary.textContent = "🤔 thinking…";
		summary.style.cursor = "pointer";
		summary.style.color = "#666";
		var body = document.createElement("div");
		body.style.fontSize = "11px";
		body.style.color = "#888";
		body.style.maxHeight = "8em";
		body.style.overflowY = "auto";
		body.style.padding = "4px 6px";
		details.appendChild(summary);
		details.appendChild(body);
		historyEl.appendChild(details);
		historyEl.scrollTop = historyEl.scrollHeight;
		currentThinkingBlock = details;
		currentThinkingBody  = body;
		return body;
	}

	function collapseThinkingBlock() {
		if (currentThinkingBlock) {
			currentThinkingBlock.open = false;
			var summary = currentThinkingBlock.querySelector("summary");
			if (summary) summary.textContent = "🤔 thinking (finished)";
		}
		currentThinkingBlock = null;
		currentThinkingBody  = null;
	}

	var currentThinkingBlock = null;
	var currentThinkingBody  = null;

	function currentPageState() {
		var reader = window[STATE_GLOBAL] || {};
		var out = {};
		Object.keys(reader).forEach(function(k) {
			try { out[k] = reader[k](); } catch (e) { out[k] = "<error: " + e.message + ">"; }
		});
		return out;
	}

	function currentSystemPrompt() {
		return [
			"You are integrated into a web page as an AI assistant. You have tools available to change page state or fetch information.",
			"",
			"RULES for tool use:",
			"1. When a state change or data fetch is needed, invoke the matching tool via a function call. Do not describe the intent in text without invoking (a textual promise like \"I will add X\" is a failure).",
			"2. After ANY tool has returned a result (visible in the conversation history as a role:tool message), YOUR NEXT MESSAGE MUST BE A PLAIN-TEXT ANSWER using that result. DO NOT emit another tool call.",
			"3. Especially: NEVER call the SAME tool twice in a row with the same or similar arguments — its earlier result is already in the conversation history. If you need to reference it, read it from there.",
			"4. Only call an additional tool if the user's request TRULY requires more work that isn't covered by prior results (rare — most requests need one tool call and a synthesis).",
			"",
			"Current page state:",
			JSON.stringify(currentPageState(), null, 2)
		].join("\n");
	}

	// Per-turn AbortController — lets the Clear button (or a new submit)
	// terminate an in-flight runChatLoop, including any pending fetch to
	// the LLM broker or an MCP endpoint.
	var currentAbort = null;

	clearBtn.addEventListener("click", function() {
		if (currentAbort) { try { currentAbort.abort(); } catch (e) { /* noop */ } }
		conversation = [];
		historyEl.innerHTML = "";
	});

	formEl.addEventListener("submit", async function(e) {
		e.preventDefault();
		var userText = inputEl.value.trim();
		if (!userText) return;
		inputEl.value = "";
		appendTurn("user", userText);

		// Rebuild the system message every turn — page state is live, not a snapshot.
		var messages = [{ role: "system", content: currentSystemPrompt() }]
			.concat(conversation)
			.concat([{ role: "user", content: userText }]);

		var assistantBody = appendTurn("assistant", "");

		// If a previous turn is still running (user hit Send without waiting
		// for done), abort it before starting a new one — otherwise both
		// loops race and stream into the same bubble.
		if (currentAbort) { try { currentAbort.abort(); } catch (e) { /* noop */ } }
		currentAbort = new AbortController();

		try {
			// Wait for any in-flight well-known fetches to finish before the
			// first turn so hostWideTools is complete when the LLM sees the
			// tool menu. On second and later submits this resolves instantly.
			await wellKnownReady;

			var currentRound = 0;
			var result = await runChatLoop({
				baseUrl:       META_BASE,
				apiKeyUuid:    API_KEY_UUID,
				modelName:     MODEL,
				messages:      messages,
				localTools:    localTools,
				remoteTools:   remoteTools,
				hostWideTools: hostWideTools,
				aiActions:     window[ACTIONS_GLOBAL] || {},
				maxRounds:     MAX_ROUNDS,
				signal:        currentAbort.signal,
				onRoundStart: function(roundIdx) {
					// After round 0, the assistant is producing follow-up text after
					// tool results — start a fresh bubble so users can tell rounds apart.
					if (roundIdx > 0) {
						appendTurn("system", "🔄 round " + (roundIdx + 1) + " — LLM synthesizing with tool results");
						assistantBody = appendTurn("assistant", "");
					}
					currentRound = roundIdx;
					collapseThinkingBlock();
				},
				onThinkingDelta: function(delta) {
					// Thinking models (qwen3-6-35b, etc.) emit hundreds of these
					// before any text — show them so the widget doesn't look hung.
					var body = ensureThinkingBlock();
					body.appendChild(document.createTextNode(delta));
					body.scrollTop = body.scrollHeight;
					historyEl.scrollTop = historyEl.scrollHeight;
				},
				onTextDelta: function(delta) {
					// First text_delta of a turn: collapse the thinking block so the
					// actual response takes the visual focus.
					collapseThinkingBlock();
					assistantBody.textContent += delta;
					historyEl.scrollTop = historyEl.scrollHeight;
				}
			});
			conversation.push({ role: "user",      content: userText });
			conversation.push({ role: "assistant", content: result.content });
			if (result.dispatched.length > 0) {
				var summary = result.dispatched.map(function(d) {
					return d.error ? "❌ " + d.toolCall.name + ": " + d.error.message : "✔ " + d.toolCall.name;
				}).join(", ");
				appendTurn("system", "Actions: " + summary);
			}
			if (result.skipped.length > 0) {
				appendTurn("system", "Skipped (no handler): " +
					result.skipped.map(function(t) { return t.name; }).join(", "));
			}
			if (result.stopped_reason) {
				appendTurn("system", "⚠ " + result.stopped_reason);
			}
		} catch (err) {
			// User-initiated abort is a normal termination, not an error.
			if (err.name === "AbortError" || /aborted/i.test(err.message || "")) {
				appendTurn("system", "⏹ stopped");
			} else {
				appendTurn("error", err.message);
			}
		} finally {
			currentAbort = null;
		}
	});
</script>
